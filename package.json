{
  "name": "auto-voucher",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup:python": "python3 -m pip install -e .",
    "serve": "PYTHONPATH=backend python3 -m auto_voucher --no-browser",
    "start": "npm run build && PYTHONPATH=backend python3 -m auto_voucher",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:backend": "PYTHONPATH=backend python3 -m unittest discover -s backend/tests -v",
    "check": "npm test && npm run test:backend && npm run build"
  },
  "devDependencies": {
    "vite": "^7.0.4"
  }
}
